# Copy to .env for local runs. Expo inlines every EXPO_PUBLIC_* value into the
# JavaScript bundle at build time, so these are public by definition — never put
# a secret here.

# Supabase project — sign-in, password reset, gratitude journal, image upload.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# AI requests use the authenticated Supabase Edge Function named ai-object.
# Configure AI_API_KEY in Supabase Edge Function Secrets; never put provider
# credentials in this file or in any EXPO_PUBLIC_* variable.
